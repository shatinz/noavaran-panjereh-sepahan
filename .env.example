# --- Admin panel -----------------------------------------------------------
# Initial admin credentials default to username admin / password noavaran2026.
# Admin must change credentials upon first login. ADMIN_PASSWORD can optionally override initial seed.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Random string (>= 16 chars) used to sign admin session cookies. REQUIRED in production.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# --- Site ---------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://noavaranpanjereh.com

# --- Google ---------------------------------------------------------------------
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Google Search Console (real SEO numbers in the admin dashboard)
# Either put gsc-credentials.json in the project root, or set the JSON/base64 here.
# GSC_CREDENTIALS_JSON=
# Optional: force a property, e.g. sc-domain:noavaranpanjereh.com
# GSC_SITE_URL=
